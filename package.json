{
  "name": "aviators",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./gas/tailwind-input.css -o ./gas/tailwind-built.css --minify && node ./scripts/wrap-css-include.mjs",
    "watch:css": "node ./scripts/watch-css.mjs",
    "build:kg-vis": "node ./scripts/build-kg-vis-include.mjs",
