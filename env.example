# Aviators — plantilla de Script Properties (sin secretos; commitear como referencia)
#
# Copiá a env.local y completá valores. env.local está en .gitignore.
# Apps Script → Configuración del proyecto → Propiedades del script
#
# Claves en código: gas/application/LlmConfig.js → AVIATORS_PROP
#
# Roles de usuario: tabla `roles` en Supabase (role_key). No hay planilla ni ADMIN_SHEET_ROLES.

# --- Supabase (backend operativo) ---
AVIATORS_DATA_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SCHEMA=public

# --- Infraestructura ---
# Drive: solo PDFs de casos de éxito
DRIVE_ROOT_FOLDER_ID=

# --- Salesforce Airlines Accounts (Google Sheet → sync diario) ---
# ID o URL: https://docs.google.com/spreadsheets/d/<ID>/edit
SALESFORCE_ACCOUNTS_SPREADSHEET_ID=

# --- Globant / LLM ---
GLOBANT_AGENTS_API_KEY=
GLOBANT_RAG_BASE_URL=https://api.clients.geai.globant.com
LLM_PROVIDER=
GLOBANT_API_MODE=
GLOBANT_RAG_PROFILE_NAME=
GLOBANT_PROJECT_ID=
GLOBANT_RAG_DOCUMENT_ID=
GLOBANT_RAG_SKIP_UPLOAD=
GLOBANT_RAG_EXECUTE_MAX_RETRIES=
GLOBANT_RAG_SKIP_AUTO_PROFILE=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Admin corpus Drive ---
# Notificaciones de solicitudes de acceso (coma). Vacío ⇒ admins en tabla roles (Supabase).
ADMIN_EMAILS=
ADMIN_KNOWLEDGE_SOURCES=
ADMIN_KNOWLEDGE_FOLDER_IDS=
ADMIN_KNOWLEDGE_PROFILE_NAME=aviators-drive-corpus
ADMIN_SYNC_MAX_FILES=

# --- Solo migración one-shot (opcional; no usado en runtime) ---
# ROLES_SPREADSHEET_ID=
